{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Griddle",
  "version": "1.0.0",
  "identifier": "design.ivg.griddle",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Griddle",
        "width": 340,
        "height": 720,
        "minWidth": 300,
        "minHeight": 480,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
